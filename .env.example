# Environment Configuration Template
# Copy this file to .env locally and fill in appropriate values.
# DO NOT COMMIT REAL SECRETS TO GIT.

# ==============================================================================
# APPLICATION ENVIRONMENT
# ==============================================================================
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=true

# ==============================================================================
# NETWORK & SERVICE URLS
# ==============================================================================
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
API_V1_PREFIX=/api/v1

# ==============================================================================
# DATABASE CONFIGURATION (PostgreSQL + pgvector)
# ==============================================================================
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=campuslink
POSTGRES_PASSWORD=campuslink_dev_pass
POSTGRES_DB=campuslink_db
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_SERVER}:${POSTGRES_PORT}/${POSTGRES_DB}

# ==============================================================================
# AI & LLM PROVIDER CONFIGURATION
# ==============================================================================
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-pro

# ==============================================================================
# EMBEDDINGS CONFIGURATION
# ==============================================================================
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIMENSION=768

# ==============================================================================
# AUTHENTICATION & SECURITY SECRETS
# ==============================================================================
JWT_SECRET=change_this_to_a_secure_random_string_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=115200

# ==============================================================================
# OBJECT STORAGE CONFIGURATION
# ==============================================================================
S3_BUCKET_NAME=campuslink-uploads
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=your_access_key_here
S3_SECRET_ACCESS_KEY=your_secret_key_here
S3_ENDPOINT_URL=http://localhost:9000
